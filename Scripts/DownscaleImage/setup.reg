Windows Registry Editor Version 5.00

[-HKEY_CLASSES_ROOT\SystemFileAssociations\image\shell\Downscale]

[HKEY_CLASSES_ROOT\SystemFileAssociations\image\shell\MaxScale]
"MUIVerb"="MaxScale (64) to..."
"SubCommands"="MS1;MS2;MS3;MS4"

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\CommandStore\shell\MS1]
@="1 MP"
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\CommandStore\shell\MS1\command]
@="powershell.exe -ExecutionPolicy Bypass -WindowStyle Hidden -File \"D:\\Scripts\\Scripts\\DownscaleImage\\downscale.ps1\" \"%1\" 1"

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\CommandStore\shell\MS2]
@="2 MP"
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\CommandStore\shell\MS2\command]
@="powershell.exe -ExecutionPolicy Bypass -WindowStyle Hidden -File \"D:\\Scripts\\Scripts\\DownscaleImage\\downscale.ps1\" \"%1\" 2"

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\CommandStore\shell\MS3]
@="3 MP"
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\CommandStore\shell\MS3\command]
@="powershell.exe -ExecutionPolicy Bypass -WindowStyle Hidden -File \"D:\\Scripts\\Scripts\\DownscaleImage\\downscale.ps1\" \"%1\" 3"

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\CommandStore\shell\MS4]
@="4 MP"
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\CommandStore\shell\MS4\command]
@="powershell.exe -ExecutionPolicy Bypass -WindowStyle Hidden -File \"D:\\Scripts\\Scripts\\DownscaleImage\\downscale.ps1\" \"%1\" 4"